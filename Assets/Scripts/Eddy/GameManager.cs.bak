using System.Collections.Generic;
using System.Collections;
using UnityEngine.SceneManagement;
using UnityEngine;
using UnityEngine.UI;
using TMPro;

public class GameManager : MonoBehaviour
{
    [Header("Données du jeu")]
    public List<WordData> listeMots;
    private int indexMotActuel = 0;

    [Header("Références UI")]
    public Image imageCibleUI;
    public Transform zoneConstruction;
    public Transform zonePioche;
    public GameObject prefabCarteSyllabe;
    public TextMeshProUGUI texteFeedback;
    public TextMeshProUGUI texteScore;

    [Header("Récompenses visuelles")]
    public ParticleSystem effetVictoire;
    private int etoilesGagnees = 0;

    [Header("Audio")]
    public AudioSource lecteurAudio;
    public AudioClip sonVictoire;
    public AudioClip sonErreurDoux;

    [Header("Couleurs adaptées")]
    public Color couleurSyllabe1 = new Color(0.82f, 0.91f, 0.96f); // Bleu pastel
    public Color couleurSyllabe2 = new Color(0.85f, 0.95f, 0.85f); // Vert pastel

    private List<string> reponseJoueur = new List<string>();
    private List<SyllableCard> cartesPlacees = new List<SyllableCard>();

    [Header("Paramètres d'aléatoire")] // NOUVEAU
    public int nombreIntrusAleatoires = 2; // Nombre de fausses syllabes ajoutées automatiquement
	public TextMeshProUGUI texteNbSyllabes; // NOUVEAU : Indicateur du nombre de syllabes
	
    void Start()
    {
        if (listeMots != null && listeMots.Count > 0)
        {
			MelangerListeMots(); // NOUVEAU : Mélange tous les mots au lancement de la scène
            ChargerMot(indexMotActuel);
        }
    }
	
    // NOUVEAU : Mélange l'ordre d'apparition des mots
    private void MelangerListeMots()
    {
        for (int i = 0; i < listeMots.Count; i++)
        {
            WordData temp = listeMots[i];
            int randomIndex = Random.Range(i, listeMots.Count);
            listeMots[i] = listeMots[randomIndex];
            listeMots[randomIndex] = temp;
        }
    }
	
    public void ChargerMot(int index)
    {
        // 1. Nettoyer les zones précédentes
        foreach (Transform child in zoneConstruction) Destroy(child.gameObject);
        foreach (Transform child in zonePioche) Destroy(child.gameObject);
        
        reponseJoueur.Clear();
        cartesPlacees.Clear();
        if (texteFeedback != null) texteFeedback.text = "";

        // 2. Charger les informations du mot actuel
        WordData mot = listeMots[index];
        if (imageCibleUI != null) imageCibleUI.sprite = mot.imageObjet;
		imageCibleUI.color = new Color(1f, 1f, 1f, 1f);
        JouerSon(mot.audioMotComplet);

        if (texteNbSyllabes != null)
        {
            int nb = mot.syllabesCorrectes.Length;
            texteNbSyllabes.text = "Choisis " + nb + (nb > 1 ? " syllabes" : " syllabe");
        }
		
        // 3. Préparer la liste globale des syllabes (justes + intrus)
        List<(string texte, AudioClip audio)> poolSyllabes = new List<(string, AudioClip)>();
        
        // Ajouter les syllabes justes
        for (int i = 0; i < mot.syllabesCorrectes.Length; i++)
        {
            AudioClip clip = (mot.audioSyllabes != null && i < mot.audioSyllabes.Length) 
                ? mot.audioSyllabes[i] 
                : null;
                
            poolSyllabes.Add((mot.syllabesCorrectes[i], clip));
        }

        // B. NOUVEAU : Construire une réserve de fausses syllabes avec leur audio
        List<(string texte, AudioClip audio)> reserveIntrus = new List<(string, AudioClip)>();

        // On récupère d'abord les intrus manuels de la fiche s'il y en a
        if (mot.syllabesIntrus != null)
        {
            for (int i = 0; i < mot.syllabesIntrus.Length; i++)
            {
                AudioClip clipIntrus = (mot.audioSyllabesIntrus != null && i < mot.audioSyllabesIntrus.Length) 
                    ? mot.audioSyllabesIntrus[i] 
                    : null;
                reserveIntrus.Add((mot.syllabesIntrus[i], clipIntrus));
            }
        }

        // On ajoute aussi les syllabes des AUTRES mots de la liste comme pièges potentiels
        foreach (WordData autreMot in listeMots)
        {
            if (autreMot == mot) continue; // Ne pas piocher dans le mot actuel

            for (int i = 0; i < autreMot.syllabesCorrectes.Length; i++)
            {
                string syllabeCandidate = autreMot.syllabesCorrectes[i];
                
                // Vérifier que cette syllabe n'est pas déjà une bonne syllabe du mot actuel
                bool estDejaDansLeMot = System.Array.Exists(mot.syllabesCorrectes, s => s == syllabeCandidate);
                
                if (!estDejaDansLeMot)
                {
                    AudioClip clipCandidate = (autreMot.audioSyllabes != null && i < autreMot.audioSyllabes.Length) 
                        ? autreMot.audioSyllabes[i] 
                        : null;
                    reserveIntrus.Add((syllabeCandidate, clipCandidate));
                }
            }
        }

        // Mélanger la réserve d'intrus et en piocher le nombre souhaité
        for (int i = 0; i < reserveIntrus.Count; i++)
        {
            var temp = reserveIntrus[i];
            int randomIndex = Random.Range(i, reserveIntrus.Count);
            reserveIntrus[i] = reserveIntrus[randomIndex];
            reserveIntrus[randomIndex] = temp;
        }

        int intrusAAjouter = Mathf.Min(nombreIntrusAleatoires, reserveIntrus.Count);
        for (int i = 0; i < intrusAAjouter; i++)
        {
            poolSyllabes.Add(reserveIntrus[i]);
        }

        // 4. Mélanger l'ensemble des cartes (bonnes syllabes + intrus piochés)
        for (int i = 0; i < poolSyllabes.Count; i++)
        {
            var temp = poolSyllabes[i];
            int randomIndex = Random.Range(i, poolSyllabes.Count);
            poolSyllabes[i] = poolSyllabes[randomIndex];
            poolSyllabes[randomIndex] = temp;
        }

        // 5. Créer les cartes visuelles dans la zone de pioche
        for (int i = 0; i < poolSyllabes.Count; i++)
        {
            GameObject nouvelleCarte = Instantiate(prefabCarteSyllabe, zonePioche);
            SyllableCard scriptCarte = nouvelleCarte.GetComponent<SyllableCard>();
            
            Color couleurChoisie = (i % 2 == 0) ? couleurSyllabe1 : couleurSyllabe2;
            scriptCarte.Initialiser(poolSyllabes[i].texte, poolSyllabes[i].audio, couleurChoisie, this);

            Button btn = nouvelleCarte.GetComponent<Button>();
            if (btn != null)
            {
                ColorBlock blocCouleurs = btn.colors;
                blocCouleurs.pressedColor = (couleurChoisie == couleurSyllabe1) 
                    ? new Color(0f, 0.5f, 1f) 
                    : new Color(0.2f, 0.7f, 0.3f);
                btn.colors = blocCouleurs;
            }
        }
		MettreAJourCompteurSyllabes();
    }

    public void SelectionnerSyllabe(SyllableCard carte, string valeur)
    {
        WordData motActuel = listeMots[indexMotActuel];
        if (reponseJoueur.Count >= motActuel.syllabesCorrectes.Length) return;

        carte.transform.SetParent(zoneConstruction);
        carte.DefinirEtatPlace(true);
        
        reponseJoueur.Add(valeur);
        cartesPlacees.Add(carte);

        if (reponseJoueur.Count == motActuel.syllabesCorrectes.Length)
        {
            VerifierReponse();
        }
		MettreAJourCompteurSyllabes();
    }

    public void RetirerSyllabe(SyllableCard carte)
    {
        int index = cartesPlacees.IndexOf(carte);
        if (index != -1)
        {
            reponseJoueur.RemoveAt(index);
            cartesPlacees.RemoveAt(index);
            carte.transform.SetParent(zonePioche);
            carte.DefinirEtatPlace(false);
            if (texteFeedback != null) texteFeedback.text = "";
        }
		MettreAJourCompteurSyllabes();
    }

    private void VerifierReponse()
    {
        WordData motActuel = listeMots[indexMotActuel];
        string motForme = string.Join("", reponseJoueur);

        if (motForme == motActuel.motComplet)
        {
            if (texteFeedback != null){
				texteFeedback.text = "Bravo ! C'est bien : " + motActuel.motComplet;
				texteFeedback.color = new Color(0.0f, 0.8f, 0.25f);
				texteFeedback.outlineWidth = 0.3f; // Épaisseur du contour (comprise entre 0.0 et 1.0)
				texteFeedback.outlineColor = new Color32(0, 0, 0, 255); // Contour noir
			} 
			//JouerSon(sonVictoire);

            
            if (effetVictoire != null)
            {
                effetVictoire.Play();
            }

            etoilesGagnees++;
            if (texteScore != null)
            {
                texteScore.text = "Indices Trouvés : " + etoilesGagnees;
            }
			Invoke(nameof(MotSuivant), 2f);
			//Invoke(nameof(ReturnGame), 2f);
        }
        else
        {
            if (texteFeedback != null){
				texteFeedback.text = "Écoute bien les syllabes et essaie encore.";
				texteFeedback.color = new Color(0.75f, 0.25f, 0.25f);
				texteFeedback.outlineWidth = 0.3f; // Épaisseur du contour (comprise entre 0.0 et 1.0)
				texteFeedback.outlineColor = new Color32(0, 0, 0, 255); // Contour noir
			}
            //JouerSon(sonErreurDoux);
			Invoke(nameof(MotActuel), 2f);
        }

		/*
		if(etoilesGagnees == 3){
			Invoke(nameof(ReturnGame), 1.5f);
		}
			*/
    }
	
    private void MotActuel()
    {
        indexMotActuel = (indexMotActuel) % listeMots.Count;
		//MelangerListeMots();
        ChargerMot(indexMotActuel);
    }
	
    private void MotSuivant()
    {

		
	indexMotActuel++;

    // Condition : Si le joueur a trouvé les 3 mots
    if (indexMotActuel >= 3 || indexMotActuel >= listeMots.Count)
    {
        SceneManager.LoadScene("Game"); // Remplacez par le nom exact de votre scène
		//Invoke(nameof(ReturnGame), 1.5f);
        return;
    }

    ChargerMot(indexMotActuel);
		
    }

    public void ReecouterMot()
    {
        if (listeMots != null && listeMots.Count > 0)
        {
            JouerSon(listeMots[indexMotActuel].audioMotComplet);
        }
    }

    public void JouerSon(AudioClip clip)
    {
        if (clip != null && lecteurAudio != null)
        {
            lecteurAudio.Stop();
            lecteurAudio.PlayOneShot(clip);
        }
    }
	/*
	public void ReturnGame(){
		indexMotActuel = (indexMotActuel) % listeMots.Count;
		if(indexMotActuel == 0){
			SceneManager.LoadScene("Game");
			//SceneManager.LoadScene(SceneManager.GetActiveScene().buildIndex - 1);
		}
	}
	*/
	private void MettreAJourCompteurSyllabes()
    {
        if (texteNbSyllabes != null && listeMots.Count > 0)
        {
            int total = listeMots[indexMotActuel].syllabesCorrectes.Length;
            int placees = reponseJoueur.Count;
            texteNbSyllabes.text = "Syllabes placées : " + placees + " / " + total;
        }
    }


}
